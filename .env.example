# 로컬 개발용 예시입니다. 이 파일을 .env로 복사한 뒤 사용하세요.
# 실제 배포 비밀번호를 이 파일에 기록하지 마세요.
DEMO_USER_ID=demo-user
POSTGRES_HOST=127.0.0.1
POSTGRES_PORT=5432
POSTGRES_USER=cargo
POSTGRES_PASSWORD=cargo_local_only
POSTGRES_DB=cargo
DB_CONNECT_TIMEOUT=3
DB_STATEMENT_TIMEOUT_MS=5000

CALCULATION_TIMEOUT_SECONDS=2
CALCULATION_MAX_CANDIDATES=20
PREVIEW_TTL_SECONDS=600
# 자연어 요청, 상품 검색, 쌓기 판단을 사용할 때 설정합니다.
# 키가 없으면 일반 계산은 바닥 배치만 사용합니다.
OPENAI_API_KEY=
OPENAI_MODEL=gpt-6.1-terra
LLM_TIMEOUT_SECONDS=20
LLM_MAX_OUTPUT_TOKENS=4000

# 두 앱의 알림 API 연결에 사용할 임의 키(32자 이상)입니다. 실제 키는 커밋하지 마세요.
NOTIFICATION_API_KEY=
FIREBASE_PROJECT_ID=
# Firebase 서비스 계정 JSON은 저장소 밖에 두고 절대 경로를 지정합니다.
GOOGLE_APPLICATION_CREDENTIALS=
PUSH_HTTP_TIMEOUT_SECONDS=5
PUSH_RETRY_DELAY_SECONDS=60
NOTIFICATION_EVENT_MAX_AGE_SECONDS=600
